rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Google認証ユーザー（管理者）かどうか
    function isGoogleAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // 評価項目設定: 読み取りは全員、書き込みは管理者のみ
    match /config/{document} {
      allow read: if true;
      allow write: if isGoogleAuth();
    }

    // 児童一覧:
    //   get   = ID指定の1件取得。児童ログインに必要なため全員に許可
    //   list  = 名簿の一覧取得。外部からの名簿吸い出しを防ぐため管理者のみ
    //   write = 管理者のみ
    match /students/{studentId} {
      allow get: if true;
      allow list: if isGoogleAuth();
      allow write: if isGoogleAuth();
    }

    // クラス: 読み取りは全員、書き込みは管理者のみ
    match /classes/{classId} {
      allow read: if true;
      allow write: if isGoogleAuth();
    }

    // 管理者一覧: 管理者のみ読み書き可
    match /admins/{email} {
      allow read, write: if isGoogleAuth();
    }

    // 児童の記録: 認証済みユーザーが読み書き可。ただし teacherSign は管理者のみ変更可
    match /users/{userId}/entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isGoogleAuth() || request.resource.data.teacherSign == false);
      allow update: if request.auth != null
        && (isGoogleAuth() || request.resource.data.teacherSign == resource.data.teacherSign);
      allow delete: if request.auth != null;
    }
  }
}
